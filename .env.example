# Copy to .env.local and fill in.

# Automation — every RFQ is POSTed here as JSON.
# Import n8n/rfq-workflow.json into n8n, activate it, and paste the
# production webhook URL below.
N8N_WEBHOOK_URL=

# Public site URL, used for canonical tags, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://example.com

# ---- Marketing (all optional; nothing loads unless set) ----
NEXT_PUBLIC_GA_ID=            # G-XXXXXXXXXX      Google Analytics 4
NEXT_PUBLIC_GTM_ID=           # GTM-XXXXXXX       Google Tag Manager
NEXT_PUBLIC_META_PIXEL_ID=    # 1234567890        Meta Pixel
NEXT_PUBLIC_CLARITY_ID=       # abcdefghij        Microsoft Clarity (free heatmaps)

# ---- Notifications (set at least ONE, or nothing reaches you) ----
# WhatsApp via Meta Cloud API — fastest to actually get read
OWNER_WHATSAPP=              # 919876543210
WHATSAPP_TOKEN=              # Meta permanent access token
WHATSAPP_PHONE_ID=           # Meta phone number ID

# Email via Resend
OWNER_EMAIL=                 # you@yourdomain.com (comma separated for several)
RESEND_API_KEY=              # re_xxxxxxxx
NOTIFY_FROM=                 # enquiries@yourdomain.com (verified sender)
